#!/usr/bin/env bash
# Collects hardware facts for the hardware gate into one text file.
# Read-only: it changes nothing on the iMac.
#
# Usage: m0-check [OUTPUT_FILE]
stamp="$(date +%Y%m%d-%H%M%S)"
out="${1:-/root/imac-display/docs/m0-facts-$stamp.txt}"
[ -d "$(dirname "$out")" ] || out="/root/m0-facts-$stamp.txt"

sec() { printf '\n===== %s =====\n' "$1"; }

{
  sec "system"
  date
  uname -a
  cat /proc/cmdline
  echo "model: $(dmidecode -s system-product-name 2>/dev/null) / $(dmidecode -s system-version 2>/dev/null)"
  echo "firmware: $(dmidecode -s bios-version 2>/dev/null)"

  sec "cpu and memory"
  lscpu | grep -E 'Model name|^CPU\(s\)|Thread|Core'
  free -h

  sec "pci devices and drivers"
  lspci -nnk

  sec "displays (drm connectors)"
  for c in /sys/class/drm/card*-*; do
    [ -e "$c" ] || continue
    echo "$c: status=$(cat "$c/status" 2>/dev/null) enabled=$(cat "$c/enabled" 2>/dev/null)"
    head -6 "$c/modes" 2>/dev/null | sed 's/^/    /'
  done
  echo "console framebuffer: $(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null)"
  ls /sys/class/backlight/ 2>/dev/null | sed 's/^/backlight: /'

  sec "graphics driver messages"
  dmesg | grep -iE 'amdgpu|radeon|\[drm\]|i915' | tail -80

  sec "video decode (vainfo per render node)"
  for d in /dev/dri/renderD*; do
    [ -e "$d" ] || continue
    echo "-- $d"
    vainfo --display drm --device "$d" 2>&1 | tail -40
  done

  sec "thunderbolt"
  lsmod | grep -i thunderbolt
  for d in /sys/bus/thunderbolt/devices/*; do
    [ -e "$d" ] || continue
    echo "$d: $(cat "$d/vendor_name" 2>/dev/null) $(cat "$d/device_name" 2>/dev/null)"
  done
  dmesg | grep -iE 'thunderbolt|xdomain' | tail -60

  sec "network"
  ip -br link
  ip -br addr
  networkctl --no-pager 2>/dev/null

  sec "wifi and bluetooth"
  lspci -nn -d 14e4:
  lsmod | grep -E '^(brcm|wl|bcma|b43|cfg80211|btusb)'
  iw dev 2>/dev/null
  lsusb | grep -i -E 'bluetooth|broadcom'

  sec "audio"
  aplay -l 2>&1
  arecord -l 2>&1
  for c in /proc/asound/card*/codec#*; do
    [ -e "$c" ] || continue
    echo "-- $c"
    head -12 "$c"
  done
  dmesg | grep -iE 'snd_hda|cs420|hdaudio' | tail -30

  sec "storage (read-only inspection)"
  lsblk -o NAME,SIZE,TYPE,TRAN,ROTA,FSTYPE,LABEL,MODEL
  for d in /dev/sd? /dev/nvme?n1; do
    [ -e "$d" ] || continue
    echo "-- $d"
    smartctl -i "$d" 2>&1 | grep -E 'Model|Rotation|Capacity|Form Factor|SATA Version' | sed 's/^/    /'
  done

  sec "usb devices"
  lsusb

  sec "temperatures and fans"
  sensors 2>/dev/null | head -60
} > "$out" 2>&1

echo "m0-check: wrote $out"
